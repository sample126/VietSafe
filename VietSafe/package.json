{
  "name": "vietsafe-dev-tools",
  "private": true,
  "description": "Công cụ phát triển (format/lint/test frontend). KHÔNG cần để chạy ứng dụng.",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"frontend/{js,css,tests}/**/*.{js,mjs,css}\" frontend/index.html eslint.config.js",
    "format:check": "prettier --check \"frontend/{js,css,tests}/**/*.{js,mjs,css}\" frontend/index.html eslint.config.js",
    "lint": "eslint .",
    "check:js": "npm run format:check && npm run lint",
    "test:frontend": "node frontend/tests/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=20"
  }
}
